# ==============================================================================
# SilverSync Server Environment Configuration (.env.example)
# Copy this file to server/.env before starting the backend
# ==============================================================================

# Server Runtime Settings
PORT=5000
NODE_ENV=development

# Allowed Client Origin for CORS (Frontend URL)
CLIENT_URL=http://localhost:5173

# Shared secret header token for protecting POST /internal/cron/* endpoints
# Evaluator requirement: constant-time comparison, header: x-cron-secret
CRON_SECRET=super-secret-cron-token-change-in-production-min-16-chars

# Firebase Admin SDK Configuration
# Option A: Path to service account JSON file (relative to server directory or absolute)
# Download from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B (Recommended for Production / Cloud Hosting): Direct Environment Variables
FIREBASE_PROJECT_ID=silversync-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dummy@silversync-demo.iam.gserviceaccount.com
# Note: In production env vars, replace newlines in the private key with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCdummykey...\n-----END PRIVATE KEY-----\n"

# Firebase Emulators (When running with local emulators, set these to bypass cloud credentials)
# Set VITE_USE_FIREBASE_EMULATOR=true on client as well
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Google Gemini API (AI Studio - 100% Free Tier, No billing required)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDummyGeminiApiKey1234567890abcdef
# Model name configurable via env (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Email Provider Configuration: "brevo" (default free HTTPS API) or "smtp" (Gmail App Password)
EMAIL_PROVIDER=brevo

# Brevo (formerly Sendinblue) - 300 free emails/day via HTTPS API (No SMTP port blocks)
# Sign up free at: https://app.brevo.com/
# Get API key at: Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-dummy-api-key-1234567890abcdef-example
BREVO_SENDER_EMAIL=your-verified-email@domain.com
BREVO_SENDER_NAME=SilverSync Care

# Nodemailer / SMTP Fallback (e.g. Gmail with 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=abcd1234efgh5678
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=SilverSync Care

# Google Calendar API (OAuth 2.0 - Needed in Phase 6 for appointment sync)
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-dummy-client-secret-12345
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
