# ==============================================================================
# SilverSync Client Environment Configuration (.env.example)
# Copy this file to client/.env before starting the frontend
# ==============================================================================

# Backend API Base URL (include /api/v1)
# Local development default: http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase Web App Configuration
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment123456789
VITE_FIREBASE_AUTH_DOMAIN=silversync-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=silversync-demo
VITE_FIREBASE_STORAGE_BUCKET=silversync-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase Cloud Messaging (Web Push) Public VAPID Key (Optional for F1-F5, needed in F6)
# Found in: Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=BDummyVapidPublicKeyForWebPushNotification1234567890abcdefghijklmnopqrstuvwxyz_example

# Firebase Emulator toggle: set to "true" to point to local Firebase Auth & Firestore emulators
# Set to "false" to connect to real Firebase cloud project
VITE_USE_FIREBASE_EMULATOR=false
